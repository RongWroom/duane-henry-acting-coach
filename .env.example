# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for the /api/send-email serverless function
# (coaching inquiry form). Get this from https://resend.com/api-keys.
# In production, add this in the Vercel project settings (Environment Variables).
RESEND_API_KEY="MY_RESEND_API_KEY"

# Resend dashboard template IDs (https://resend.com/emails/templates).
# CLIENT: branded confirmation sent to the actor (includes PayPal payment link).
# ADMIN: booking notification sent to Duane with the client's intake details.
RESEND_CLIENT_TEMPLATE_ID="tmpl_xxxxxxxxxxxx"
RESEND_ADMIN_TEMPLATE_ID="tmpl_xxxxxxxxxxxx"

# TURNSTILE_SECRET_KEY: Cloudflare Turnstile secret key, required by
# /api/send-email to verify the inquiry form widget token.
# Get this from https://dash.cloudflare.com/?to=/:account/turnstile
# In production, add this in the Vercel project settings (Environment Variables).
TURNSTILE_SECRET_KEY="MY_TURNSTILE_SECRET_KEY"

# VITE_TURNSTILE_SITE_KEY: Optional override for the public Turnstile site key
# rendered by the inquiry form (defaults to the production key in code).
# Use Cloudflare's always-pass test key for local development:
# VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
