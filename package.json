{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && tsx scripts/prerender.tsx",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:tailwind": "tailwind-lint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:tailwind:fix": "tailwind-lint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "prepare": "node scripts/install-pre-commit.mjs",
    "test:loading": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "resend": "^6.28.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^13.0.0",
    "autoprefixer": "^10.4.21",
    "tailwind-lint": "^0.12.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.27.0": true,
    "esbuild@0.28.2": true
  }
}
